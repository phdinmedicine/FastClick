name: Build FastClick (Fabric 1.21.4)

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Show Java version
        run: java -version

      - name: Grant execute for gradlew
        run: chmod +x ./gradlew

      - name: Build (Gradle)
        run: ./gradlew clean build --no-daemon --parallel
        env:
          ORG_GRADLE_PROJECT_minecraft_version: 1.21.4
          ORG_GRADLE_PROJECT_yarn_mappings: 1.21.4+build.0:v2
          ORG_GRADLE_PROJECT_loader_version: 0.14.0
          ORG_GRADLE_PROJECT_fabric_api_version: 1.71.0+1.21.4

      - name: Upload artifact (JAR)
        uses: actions/upload-artifact@v4
        with:
          name: fastclick-jars
          path: build/libs/*.jar
